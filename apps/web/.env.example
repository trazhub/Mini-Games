# Public values only - everything prefixed VITE_ is embedded in the browser bundle.
# Backend base URL (HTTPS in production). When unset in dev the app uses http://<current host>:2567.
VITE_API_URL=http://localhost:2567
# Product name shown in the UI (easy re-branding)
VITE_APP_NAME=MiniGameHub
# GitHub Pages project sites: /<repository-name>/   (set by the deploy workflow)
# VITE_BASE_PATH=/minigamehub/
