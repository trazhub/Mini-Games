    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/pg": "^8.15.0",
