# MiniGameHub configuration template. Copy to .env and edit. NEVER commit the real .env.
# This file contains no secrets.

# ---------------------------------------------------------------------------------------------
# Game server (apps/server)  -  all read by the server process / docker compose
# ---------------------------------------------------------------------------------------------
NODE_ENV=development
PORT=2567
HOST=0.0.0.0

# Browser origins allowed to call the API and open WebSockets (comma separated, no trailing slash).
# Development default covers the Vite dev (5173) and preview (4173) servers.
# Production:  ALLOWED_ORIGINS=https://trazhub.github.io
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# HMAC key for guest session tokens. REQUIRED in production (>= 32 chars).
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# PostgreSQL. Leave empty in development to run without persistence.
# Local dev with docker compose -f infra/docker/compose.dev.yml:
# DATABASE_URL=postgres://mgh:mgh_dev_only@127.0.0.1:5432/minigamehub
DATABASE_URL=

# true when running behind a reverse proxy (Nginx / Cloudflare Tunnel) so client IPs are read from it.
TRUST_PROXY=false

# Optional bearer token for GET /metrics (>= 16 chars). Unset: /metrics only answers loopback.
METRICS_TOKEN=

# Tunables (defaults shown)
# RECONNECT_GRACE_MS=60000
# HOST_MIGRATION_DELAY_MS=8000
# ROOM_IDLE_TTL_MS=120000
# MAX_ROOMS=500
# JOIN_RATE_PER_MIN=40
# GUEST_RATE_PER_MIN=30

# ---------------------------------------------------------------------------------------------
# Docker Compose production stack (infra/docker/compose.prod.yml) on the Ubuntu VM
# ---------------------------------------------------------------------------------------------
# Generate:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=
# LAN address the game port is published on (so the Nginx host can reach it). Never 0.0.0.0.
SERVER_BIND=10.10.15.254
BACKUP_DIR=/opt/minigamehub/backups
BACKUP_KEEP_DAYS=14
# Only for the optional Cloudflare Tunnel profile
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------------------------
# Frontend (apps/web) build-time variables. PUBLIC: embedded in the browser bundle.
# (GitHub Actions sets these for the Pages build; see .github/workflows/deploy-pages.yml)
# ---------------------------------------------------------------------------------------------
VITE_API_URL=http://localhost:2567
VITE_APP_NAME=MiniGameHub
# GitHub Pages project site base path (default for production builds is /Mini-Games/)
# VITE_BASE_PATH=/Mini-Games/
